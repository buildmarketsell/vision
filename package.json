{
  "name": "vision",
  "productName": "VISION",
  "version": "0.1.0",
  "private": true,
  "description": "Personal macOS workspace with Claude Code built in",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --mac --dir",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-react": "^8.9.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.73.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.18"
  },
  "build": {
    "appId": "com.danromanciuc.vision",
    "productName": "VISION",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
